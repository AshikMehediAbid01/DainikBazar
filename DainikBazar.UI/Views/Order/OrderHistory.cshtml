@model List<DainikBazar.UI.Models.OrderVM>

@{
    ViewData["Title"] = "History";
    var culture = new System.Globalization.CultureInfo( "bn-BD" );
}

<div>
    <h2>Order History</h2>
    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4">You have not placed any orders yet</div>
    }
    else
    {
        <div>
            @foreach (var order in Model)
            {
                <div class="mb-2">
                    <h2>Order: @order.Id</h2>
                    <p><strong>Order Date:</strong> @order.OrderDate</p>
                    <p><strong>Current Status:</strong> @order.OrderHistory</p>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody class="bd-currency">
                            @foreach(var item in order.CartItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("C",culture)</td>
                                    <td>@((item.UnitPrice * item.Quantity).ToString("C",culture))</td>
                                </tr>
                            }
                            @if (order.ProductId != null)
                            {
                                <tr>
                                    <td>@order.ProductName</td>
                                    <td>@order.Quantity</td>
                                    <td>@order.UnitPrice.ToString("C", culture)</td>
                                    <td>@((order.UnitPrice * order.Quantity).ToString("C", culture))</td>
                                </tr>
                            }
                            <tr>
                                <td></td>
                                <td></td>
                                <td><strong>Subtotal:</strong></td>
                                <td>@order.SubtotalPrice.ToString( "C", culture )</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td><strong>Delivery Charge:</strong></td>
                                <td>@order.DeliveryCharge.ToString( "C", culture )</td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td><strong>Total:</strong></td>
                                <td>@order.TotalPrice.ToString( "C", culture )</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>