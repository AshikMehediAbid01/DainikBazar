@model List<DainikBazar.UI.Models.OrderVM>

@{
    ViewData["Title"] = "Manage Orders";
    var culture = new System.Globalization.CultureInfo( "bn-BD" );
}

<div>
    <h2>Manage Orders</h2>
    <div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer Name</th>
                    <th>Order Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.UserId</td>
                        <td>@order.OrderDate</td>
                        <td class="bd-currency">@order.TotalPrice.ToString( "C", culture )</td>
                        <td>

                            <form asp-action="ManageOrders" method="post">

                                <div class="form-group d-flex flex-row gap-2">
                                    @{
                                        var historyFlow = new[] { "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };
                                        var idx = Array.IndexOf( historyFlow, order.OrderHistory );

                                        var allowedHistory = idx >= 0
                                        ? historyFlow.Skip( idx )
                                        : historyFlow;
                                    }
                                    <select name="orderHistory" id="orderHistory" class="form-control">
                                        @foreach (var status in allowedHistory)
                                        {
                                            <option value="@status" selected="@(order.OrderHistory == status ? "selected" : null)">@status</option>
                                        }
                                    </select>
                                    <input type="hidden" name="orderId" value="@order.Id" />

                                    <button type="submit" class="btn btn-danger btn-sm">Update</button>
                                </div>

                            </form>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
