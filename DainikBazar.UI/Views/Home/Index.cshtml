@using DainikBazar.UI.Models
@model IEnumerable<ProductVM>

@{
	ViewData["Title"] = "Home Page";
}



<div class="text-center mb-4">
	<h1 class="display-4">Welcome to Dainik Bazar</h1>
	<p class="lead">Your one-stop shop for all your needs</p>
	<p class="text-muted">Explore our wide range of products and enjoy great deals!</p>
</div>

@* 
<br />

<div>
    <a asp-action="Index" asp-route-categoryId=0 class="btn @(ViewBag.CategoryId == 0 ? "btn-dark" : "btn-outline-dark")">All</a>
    @foreach (var category in ViewBag.ProductTypes)
