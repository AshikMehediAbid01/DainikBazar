<br />
<br />

<div class="container">
	<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">

		@foreach (var product in Model)
		{
			var avgRating = 0.0;
			var totalRating = 0;
			if (product.ReviewAndRatings != null && product.ReviewAndRatings.Any()) 
			{
				avgRating = Math.Round(product.ReviewAndRatings.Average(r => r.Rating), 1);
				totalRating = product.ReviewAndRatings.Count();
			}

			<div class="col">
				<div class="card h-100 shadow-sm border-0 rounded-4">
					@* 
                    <img src="~/@book.Image" class="card-img-top rounded-top-4" alt="@book.Name"
                         style="height: 330px; object-fit: cover; object-position: top;" />
 *@
					<div class="card-body d-flex flex-column">
						<h6 class="card-title fw-bold text-success line-clamp-2">@product.Name</h6>
						@* <p class="card-text text-muted mb-1">by @product.Description</p> *@
						<p class="card-text fw-semibold text-dark">Price: <span class="text-success">৳@product.Price</span></p>

						<p >
							@* @ViewBag.AvgRating *@
							@for (int i = 0; i < (int)@avgRating; i++)
							{
								<i class="fa fa-star text-warning"></i>
							}
							@if (avgRating % 1 != 0)
							{
								<i class="fa-solid fa-star-half-stroke text-warning"></i>
							}
							@for (int i = (int)Math.Ceiling((double)avgRating); i < 5; i++)
							{
								<i class="fa fa-star text-secondary"></i>
							}

							<span>(@totalRating)</span>
						</p>

						<div class="mt-auto">
							<a asp-action="DetailsProduct" asp-controller="Product" asp-route-id="@product.ProductGuid" class="btn btn-success w-100">
								View Details
							</a>
						</div>
					</div>
				</div>
			</div>
		}

	</div>

</div>

<style>
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>