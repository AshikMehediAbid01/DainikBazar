@model DainikBazar.UI.Models.ReviewAndRatingVM

@{
	ViewData["Title"] = "CreateReview";
	TempData["GuId"] = ViewBag.GuId;
}

<h1>Review and Rating</h1>


<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="CreateReview" method="post">

			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@* 			<input asp-for="ProductId" value="@Model.ProductId" class="form-control" type="hidden" />
			<input asp-for="UserId" value="@Model.UserId" type="hidden" /> *@

			<input name="ProductId" value="@Model.ProductId" class="form-control" type="hidden" />
			<input name="UserId" value="@Model.UserId" type="hidden" />
			@Html.AntiForgeryToken()

			<div class="mb-3">
				<label asp-for="Rating" class="control-label"></label>
				<select name="Rating" class="form-select form-select-sm d-inline" style="width:auto;" required>
					<option value="">-- select rating --</option>
					<option value="1">★</option>
					<option value="2">★★</option>
					<option value="3">★★★</option>
					<option value="4">★★★★</option>
					<option value="5">★★★★★</option>
				</select>

			</div>




			<div class="form-group mb-4">
				<label asp-for="Review" class="control-label"></label>
				<textarea name="Review"  class="form-control" rows="2"></textarea>
				<span asp-validation-for="Review" class="text-danger"></span>
			</div>

			@* 			
				<div class="form-group">
				<label asp-for="Rating" class="control-label"></label>
				<input asp-for="Rating" class="form-control" />
				<span asp-validation-for="Rating" class="text-danger"></span>
			</div>
 *@



			@* 		
				<div class="form-group">
				<label asp-for="UserId" class="control-label"></label>
				<input asp-for="UserId" class="form-control" />
				<span asp-validation-for="UserId" class="text-danger"></span>
			</div> 
			*@

			<div class="form-group">
				<input type="submit" value="Create" class="btn btn-info btn-sm" />
				<a asp-action="DetailsProduct" asp-controller="Product" asp-route-id="@ViewBag.GuId" class="btn btn-outline-info btn-sm">Back</a>
			</div>
		</form>
	</div>
</div>



@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
