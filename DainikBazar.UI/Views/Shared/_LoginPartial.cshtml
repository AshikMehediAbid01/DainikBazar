<ul class="navbar-nav ms-auto">
    @if(User.Identity?.IsAuthenticated ?? false)
    {
        <!-- Show when logged in -->
        <li class="nav-item">
            <span class="nav-link">Welcome, @User.Identity.Name!</span>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="ChangePassword">Change Password</a>
        </li>
        <li class="nav-item">
            <form method="get" asp-controller="Account" asp-action="Logout">
                <button type="submit" class="btn btn-primary">Log Out</button>
            </form>
        </li>
    }
    else
    {
        <!-- Show when not logged in -->
        <li class="nav-item">
            <form method="get" asp-controller="Account" asp-action="Login">
                <button type="submit" class="btn btn-primary">Login</button>
            </form>
        </li>
    }
</ul>